# ====================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN TIẾNG HÀN JUNGHYEON
# ====================================================

# Cấu hình Web App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Tiếng Hàn JungHyeon"

# Supabase (Sẽ cấu hình chi tiết ở Giai đoạn 2 & 9)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Trợ lý AI Honey (Claude API - Gọi qua Route Server an toàn)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Cổng thanh toán (Giai đoạn 7)
SEPAY_API_KEY=your-sepay-api-key
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Thông báo Admin (Giai đoạn 5)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
RESEND_API_KEY=your-resend-api-key

# Admin Bootstrap & Bảo mật
ADMIN_BOOTSTRAP_EMAIL=admin@junghyeon.vn
ADMIN_REQUIRE_2FA=false
REVALIDATION_SECRET=your-revalidation-secret-here
