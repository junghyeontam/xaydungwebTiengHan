# ==============================================================================
# ENVIRONMENT VARIABLES: apps/teach (Teacher Studio - teach.junghyeon.com)
# ==============================================================================

# Surface URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_TEACH_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Cross-Subdomain SSO Cookie Configuration
# In Production: .junghyeon.com | In Staging: .staging.junghyeon.com | Localhost: leave empty
NEXT_PUBLIC_COOKIE_DOMAIN=

# Supabase Auth & Studio Client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Privileged Server-side Service Role (Server Actions & Revalidation only)
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key

# Developer Role Simulator (Non-production only)
NEXT_PUBLIC_ADMIN_DEV_PERSONA=false

# ==============================================================================
# STRICTLY FORBIDDEN IN apps/teach:
# - PAYOS_CHECKSUM_KEY
# - PAYOS_API_KEY
# - STRIPE_SECRET_KEY
# - VIETQR_SECRET
# ==============================================================================
