# ==============================================================================
# ENVIRONMENT VARIABLES: apps/web (Learner Hub - junghyeon.com)
# ==============================================================================

# Surface URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_TEACH_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Cross-Subdomain SSO Cookie Configuration
# In Production: .junghyeon.com | In Staging: .staging.junghyeon.com | Localhost: leave empty
NEXT_PUBLIC_COOKIE_DOMAIN=

# Supabase Public Client (Anon key only - reads published curriculum via RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Client Analytics & AI Chatbot
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==============================================================================
# STRICTLY FORBIDDEN IN apps/web:
# The following keys MUST NEVER be configured in apps/web.
# Doing so will trigger CI boundary scanner failure!
# - SUPABASE_SERVICE_ROLE_KEY
# - PAYOS_CHECKSUM_KEY
# - PAYOS_API_KEY
# - STRIPE_SECRET_KEY
# - VIETQR_SECRET
# - ADMIN_BOOTSTRAP_EMAIL
# ==============================================================================
