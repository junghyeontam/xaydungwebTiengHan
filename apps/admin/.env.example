# ==============================================================================
# ENVIRONMENT VARIABLES: apps/admin (Back-Office & System Area - admin.junghyeon.com)
# ==============================================================================

# Surface URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_TEACH_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Cross-Subdomain SSO Cookie Configuration
# In Production: .junghyeon.com | In Staging: .staging.junghyeon.com | Localhost: leave empty
NEXT_PUBLIC_COOKIE_DOMAIN=

# Supabase Auth & Full Database Authority
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Privileged Server-side Service Role (Immutable Audit Logging & Super Admin Operations)
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key

# Payment Gateway Secrets (Server-side vault only; never exposed via NEXT_PUBLIC_)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# External Messaging & Email Integrations
RESEND_API_KEY=re_your_api_key
ZALO_OA_ACCESS_TOKEN=your-zalo-token

# Super Admin Initial Provisioning (Production: Rotate immediately via /system/staff)
ADMIN_BOOTSTRAP_EMAIL=founder@junghyeon.vn
NEXT_PUBLIC_ADMIN_DEV_PERSONA=false
